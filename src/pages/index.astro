---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Web3Blog - El Futuro Descentralizado">
	<!-- Hero Section "Chula" -->
	<section class="mb-24 text-left animate-slide-up">
		<!-- Inline-flex badge -->
		<div
			class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/8 text-[11px] font-bold text-primary uppercase tracking-widest mb-6"
		>
			<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
			Web3 · Blockchain · Descentralización
		</div>

		<!-- Main Heading -->
		<h1 class="text-5xl md:text-7xl font-bold font-heading tracking-tight mb-8">
			Diseñando el <br />
			<span class="text-gradient">Futuro Descentralizado</span>
		</h1>

		<!-- Descriptive subtext -->
		<p class="text-xl text-(--text-muted) max-w-2xl leading-relaxed mb-10">
			Explora las capas de la tecnología blockchain, desde contratos
			inteligentes hasta protocolos de IA descentralizada.
		</p>

		<!-- CTAs if any? Just a scroll anchor for now -->
		<div>
			<a href="#articulos" class="btn-premium">Descubrir artículos</a>
		</div>
	</section>

	<!-- Article Grid -->
	<section id="articulos">
		<div class="flex items-center justify-between mb-12">
			<div class="flex items-center gap-4">
				<h2 class="text-lg font-bold font-heading text-(--text)">
					Publicaciones Recientes
				</h2>
				<div class="h-px bg-border flex-grow w-24"></div>
			</div>
			<span
				class="text-xs font-mono text-(--text-muted) uppercase tracking-widest"
				>{posts.length} {posts.length === 1 ? "artículo" : "artículos"}</span
			>
		</div>

		{
			posts.length === 0 ? (
				<div class="text-center py-24 text-(--text-muted)">
					<p class="text-sm font-mono tracking-widest uppercase">
						Próximamente...
					</p>
				</div>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
					{posts.map((post, i) => (
						<div
							style={`animation-delay: ${0.1 + 0.05 * i}s; animation-fill-mode: both;`}
							class="animate-slide-up"
						>
							<PostCard
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								url={`/posts/${post.slug}`}
								tags={post.data.tags}
							/>
						</div>
					))}
				</div>
			)
		}
	</section>
</Layout>
