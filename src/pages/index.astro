---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Web3Blog - El Futuro Descentralizado">
	<section class="mb-20 text-center pt-10 relative">
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[100px] -z-10"
		>
		</div>
		<h1
			class="text-5xl md:text-7xl font-bold mb-6 pb-2 animate-fade-in font-heading"
		>
			<span class="text-gradient-tricolor">Explorando la Web3</span>
		</h1>
		<p
			class="text-xl text-text-muted max-w-2xl mx-auto leading-relaxed animate-slide-up"
			style="animation-delay: 0.1s;"
		>
			Descubre artículos sobre blockchain, contratos inteligentes y el
			futuro de internet.
		</p>
	</section>

	<section>
		<div class="flex items-center justify-between mb-10">
			<h2
				class="text-2xl font-bold text-text-main flex items-center gap-3 font-heading"
			>
				<span class="w-2 h-8 bg-primary rounded-full"></span>
				Artículos Recientes
			</h2>
			<div class="h-px bg-border flex-grow ml-6 hidden md:block"></div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{
				posts.map((post) => (
					<PostCard
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate}
						url={`/posts/${post.slug}`}
						tags={post.data.tags}
					/>
				))
			}
		</div>
	</section>
</Layout>
