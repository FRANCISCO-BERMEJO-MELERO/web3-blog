---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.data.tags).flat()),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`#${tag} - Web3Blog`}>
  <div class="mb-20 animate-slide-up">
    <div class="flex items-center gap-3 mb-10">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-primary tracking-widest uppercase hover:underline"
      >
        &larr; VOLVER AL INICIO
      </a>
    </div>

    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/8 text-[11px] font-bold text-primary uppercase tracking-widest mb-6"
    >
      ETIQUETA FILTRADA
    </div>

    <h1
      class="text-4xl md:text-6xl font-black font-heading tracking-tight mb-4"
    >
      Artículos sobre <span class="text-gradient">#{tag}</span>
    </h1>

    <p
      class="text-xs font-bold text-[--text-muted] uppercase tracking-[0.2em] leading-loose opacity-60"
    >
      {posts.length}
      {posts.length === 1 ? "artículo encontrado" : "artículos encontrados"}
    </p>
  </div>

  <!-- Identical Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-8 animate-slide-up"
    style="animation-delay: 0.1s;"
  >
    {
      posts.map((post, i) => (
        <div
          style={`animation-delay: ${0.1 + 0.05 * i}s; animation-fill-mode: both;`}
          class="animate-slide-up"
        >
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            url={`/posts/${post.slug}`}
            tags={post.data.tags}
          />
        </div>
      ))
    }
  </div>
</Layout>
