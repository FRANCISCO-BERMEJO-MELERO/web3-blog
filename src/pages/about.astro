---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sobre mí - Web3Blog">
    <div class="max-w-6xl mx-auto pt-10 px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-12 text-center">
            <span class="text-gradient-tricolor"> Sobre mí </span>
        </h1>

        <div
            class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[minmax(180px,auto)]"
        >
            <!-- Profile Card (Large) -->
            <div
                class="md:col-span-2 lg:col-span-2 row-span-2 glass-panel rounded-3xl p-8 flex flex-col justify-center items-center text-center relative overflow-hidden group"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-primary/10 via-auxiliary/10 to-accent/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>
                <div class="relative z-10">
                    <div
                        class="w-32 h-32 mx-auto mb-6 rounded-full bg-gradient-to-r from-primary via-auxiliary to-accent p-1"
                    >
                        <div
                            class="w-full h-full rounded-full bg-color-bg-surface flex items-center justify-center overflow-hidden bg-white dark:bg-neutral-900"
                        >
                            <img src="/foto.jpg" alt="" />
                        </div>
                    </div>
                    <h2 class="text-3xl font-bold text-text-heading mb-2">
                        Fran
                    </h2>
                    <p class="text-primary font-medium mb-4">
                        Full Stack Web3 Developer
                    </p>
                    <p class="text-text-muted max-w-md mx-auto leading-relaxed">
                        Construyendo el futuro descentralizado bloque a bloque.
                        Especializado en crear experiencias de usuario fluidas
                        para dApps complejas.
                    </p>
                    <div class="flex gap-4 justify-center mt-6">
                        <a
                            href="https://github.com/FRANCISCO-BERMEJO-MELERO"
                            class="p-3 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-primary/20 hover:text-primary transition-all"
                            aria-label="GitHub Profile"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                                    clip-rule="evenodd"
                                ></path>
                            </svg>
                        </a>
                        <a
                            href="https://www.linkedin.com/in/francisco-bermejo-melero-250669302/"
                            class="p-3 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-primary/20 hover:text-primary transition-all"
                            aria-label="LinkedIn Profile"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.137.92-2.063 2.063-2.063 1.14 0 2.064.926 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm-.013 13.019H8.97V9H5.324v11.452h.005z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Philosophy Card -->
            <div
                class="md:col-span-1 lg:col-span-2 glass-panel rounded-3xl p-8 flex flex-col justify-center relative overflow-hidden"
            >
                <div
                    class="absolute -right-10 -top-10 w-40 h-40 bg-accent/20 rounded-full blur-3xl"
                >
                </div>
                <h3
                    class="text-xl font-bold text-accent mb-4 flex items-center gap-2"
                >
                    <span class="text-2xl">💡</span> Filosofía
                </h3>
                <p class="text-text-muted leading-relaxed">
                    Mi filosofía es simple: la tecnología debe empoderar, no complicar. En Web3, mi objetivo es hacer que la innovación blockchain sea accesible para todos.
                </p>
            </div>

            <!-- Stack: Frontend -->
            <div
                class="glass-panel rounded-3xl p-6 flex flex-col justify-between hover:border-primary/50 transition-colors"
            >
                <h3 class="text-lg font-bold text-text-heading mb-4">
                    Frontend
                </h3>
                <div class="flex flex-wrap gap-2">
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20"
                        >React</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20"
                        >Astro</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20"
                        >Tailwind</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20"
                        >TypeScript</span
                    >
                </div>
            </div>

            <!-- Stack: Web3 -->
            <div
                class="glass-panel rounded-3xl p-6 flex flex-col justify-between hover:border-auxiliary/50 transition-colors"
            >
                <h3 class="text-lg font-bold text-text-heading mb-4">Web3</h3>
                <div class="flex flex-wrap gap-2">
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-auxiliary/10 text-auxiliary border border-auxiliary/20"
                        >Solidity</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-auxiliary/10 text-auxiliary border border-auxiliary/20"
                        >Ethers.js</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-auxiliary/10 text-auxiliary border border-auxiliary/20"
                        >IPFS</span
                    >
                    <span
                        class="px-3 py-1 rounded-full text-xs font-medium bg-auxiliary/10 text-auxiliary border border-auxiliary/20"
                        >Viem</span
                    >
                </div>
            </div>

            <!-- Status / Connect -->
            <div
                class="md:col-span-3 lg:col-span-4 glass-panel rounded-3xl p-8 flex flex-col md:flex-row items-center justify-between gap-6 bg-gradient-to-r from-primary/5 via-auxiliary/5 to-accent/5"
            >
                <div>
                    <h3 class="text-2xl font-bold text-text-heading mb-2">
                        ¿Tienes una idea? ¡Hablemos!
                    </h3>
                    <p class="text-text-muted">
                        Estoy abierto a intercambiar conocimientos sobre el ecosistema Web3 y discutir ideas.
                    </p>
                </div>
                <a
                    href="https://www.linkedin.com/in/francisco-bermejo-melero-250669302/"
                    class="px-8 py-3 rounded-xl btn-gradient font-bold"
                >
                    Contáctame
                </a>
            </div>
        </div>
    </div>
</Layout>
