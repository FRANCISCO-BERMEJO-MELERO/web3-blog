---
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    url: string;
    tags: string[];
}

const { title, description, pubDate, url, tags } = Astro.props;
---

<article
    class="group relative rounded-2xl p-[2px] transition-all duration-300 hover:-translate-y-1 hover:shadow-xl overflow-hidden bg-linear-to-br from-primary via-auxiliary to-accent"
>
    <div
        class="relative flex flex-col h-full z-10 bg-(--color-bg-surface) rounded-2xl p-6"
    >
        <div class="mb-4">
            <div class="flex gap-2 mb-3 flex-wrap">
                {
                    tags.map((tag) => (
                        <a
                            href={`/tags/${tag}`}
                            class="relative z-20 text-xs text-gradient-tricolor font-semibold px-2.5 py-0.5 rounded-full bg-linear-to-r from-primary/10 to-auxiliary/10 text-primary hover:from-primary/20 hover:to-auxiliary/20 transition-all border border-primary/20"
                        >
                            #{tag}
                        </a>
                    ))
                }
            </div>
            <h2
                class="text-xl font-bold mb-2 text-text-main group-hover:text-primary transition-colors font-heading"
            >
                <a href={url}>
                    <span class="absolute inset-0 z-10"></span>
                    {title}
                </a>
            </h2>
            <time
                datetime={pubDate.toISOString()}
                class="text-sm text-text-muted"
            >
                {
                    pubDate.toLocaleDateString("es-ES", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </time>
        </div>
        <p
            class="text-text-muted line-clamp-3 mb-6 flex-grow text-sm leading-relaxed"
        >
            {description}
        </p>
        <div
            class="text-gradient-tricolor text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all"
        >
            Leer artículo <span>&rarr;</span>
        </div>
    </div>
</article>
