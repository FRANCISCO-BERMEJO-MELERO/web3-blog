---
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    url: string;
    tags: string[];
}

const { title, description, pubDate, url, tags } = Astro.props;
---

<article
    class="group relative glass-panel rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/10 overflow-hidden"
>
    <div
        class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    >
    </div>

    <div class="relative flex flex-col h-full z-10">
        <div class="mb-4">
            <div class="flex gap-2 mb-3 flex-wrap">
                {
                    tags.map((tag) => (
                        <a
                            href={`/tags/${tag}`}
                            class="relative z-20 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary hover:bg-primary/20 transition-colors border border-primary/20"
                        >
                            #{tag}
                        </a>
                    ))
                }
            </div>
            <h2
                class="text-xl font-bold mb-2 text-text-main group-hover:text-primary transition-colors font-heading"
            >
                <a href={url}>
                    <span class="absolute inset-0 z-10"></span>
                    {title}
                </a>
            </h2>
            <time
                datetime={pubDate.toISOString()}
                class="text-sm text-text-muted"
            >
                {
                    pubDate.toLocaleDateString("es-ES", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </time>
        </div>
        <p
            class="text-text-muted line-clamp-3 mb-6 flex-grow text-sm leading-relaxed"
        >
            {description}
        </p>
        <div
            class="text-primary text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all"
        >
            Leer artículo <span>&rarr;</span>
        </div>
    </div>
</article>
