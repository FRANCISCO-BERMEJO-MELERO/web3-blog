---

---

<div
    id="search-modal"
    class="fixed inset-0 z-[100] hidden items-start justify-center pt-[10vh] px-4 overflow-hidden"
    role="dialog"
    aria-modal="true"
>
    <!-- Backdrop: high blur for a luxury feel -->
    <div
        class="fixed inset-0 bg-black/40 backdrop-blur-md transition-opacity"
        id="search-backdrop"
    >
    </div>

    <!-- Modal: refined floating box -->
    <div
        class="relative w-full max-w-2xl bg-(--bg) border border-(--border) rounded-2xl overflow-hidden shadow-2xl animate-slide-up"
    >
        <!-- Search Input Unit -->
        <div
            class="flex items-center gap-6 px-8 h-20 border-b border-(--border)"
        >
            <svg
                class="w-5 h-5 text-primary flex-shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
                type="text"
                id="search-input"
                class="flex-1 bg-transparent text-(--text) placeholder-text-(--text-muted) focus:outline-none text-lg font-bold font-heading tracking-tight"
                placeholder="Busca por título, tag o descripción..."
                autocomplete="off"
            />
            <div
                class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-(--border) bg-surface"
            >
                <span
                    class="text-[10px] font-bold text-(--text-muted) uppercase tracking-widest"
                    >Esc</span
                >
            </div>
        </div>

        <!-- Result container -->
        <div
            id="search-results"
            class="max-h-[65vh] overflow-y-auto p-4 md:p-8 space-y-4"
        >
            <div
                class="px-2 pb-2 text-[10px] font-bold text-primary uppercase tracking-[0.2em]"
                id="results-count-label"
            >
                Resultados destacados
            </div>
            <div
                class="p-10 text-center text-(--text-muted) text-sm font-medium"
                id="search-empty"
            >
                Empieza a escribir para filtrar los artículos...
            </div>
            <ul class="flex flex-col gap-3" id="results-list"></ul>
        </div>
    </div>
</div>

<script>
    import Fuse from "fuse.js";

    let fuse;
    let posts = [];
    const modal = document.getElementById("search-modal");
    const input = document.getElementById("search-input");
    const resultsList = document.getElementById("results-list");
    const emptyState = document.getElementById("search-empty");
    const backdrop = document.getElementById("search-backdrop");
    const label = document.getElementById("results-count-label");

    async function initSearch() {
        if (posts.length > 0) return;
        try {
            const res = await fetch("/search.json");
            posts = await res.json();
            fuse = new Fuse(posts, {
                keys: [
                    { name: "title", weight: 0.7 },
                    { name: "description", weight: 0.5 },
                    { name: "tags", weight: 0.3 },
                ],
                includeScore: true,
                threshold: 0.4,
            });
        } catch (error) {
            console.error("Error loading search index:", error);
        }
    }

    function openModal() {
        modal?.classList.replace("hidden", "flex");
        document.body.style.overflow = "hidden";
        (input as HTMLInputElement).focus();
        initSearch();
    }

    function closeModal() {
        modal?.classList.replace("flex", "hidden");
        document.body.style.overflow = "";
        (input as HTMLInputElement).value = "";
        renderResults([]);
    }

    function renderResults(results) {
        if (!resultsList || !emptyState || !label) return;
        resultsList.innerHTML = "";

        if (results.length === 0) {
            emptyState.classList.remove("hidden");
            label.classList.add("hidden");
            return;
        }

        emptyState.classList.add("hidden");
        label.classList.remove("hidden");

        results.forEach((result) => {
            const item = result.item;
            const li = document.createElement("li");
            li.innerHTML = `
        <a href="/posts/${item.slug}" class="block px-6 py-5 rounded-2xl bg-surface border border-border hover:border-primary/50 hover:shadow-lg transition-all group">
          <div class="flex justify-between items-baseline gap-4 mb-2">
            <h3 class="text-base font-bold text-(--text) group-hover:text-primary transition-colors tracking-tight">${item.title}</h3>
            <span class="text-[10px] font-mono font-bold text-primary opacity-50 uppercase tracking-widest">${new Date(item.pubDate).toLocaleDateString("es-ES", { month: "short", year: "numeric" })}</span>
          </div>
          <p class="text-sm text-(--text-muted) line-clamp-1 opacity-80">${item.description}</p>
        </a>
      `;
            resultsList.appendChild(li);
        });
    }

    window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            modal?.classList.contains("hidden") ? openModal() : closeModal();
        }
        if (e.key === "Escape") closeModal();
    });

    backdrop?.addEventListener("click", closeModal);
    input?.addEventListener("input", (e) => {
        if (!fuse) return;
        const query = (e.target as HTMLInputElement).value;
        if (query.trim() === "") {
            renderResults([]);
            return;
        }
        const results = fuse.search(query);
        renderResults(results);
    });

    window.addEventListener("open-search", openModal);
</script>
