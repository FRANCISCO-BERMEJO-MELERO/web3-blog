---
const navItems = [{ href: "/", label: "Inicio" }];
---

<header
  class="sticky top-0 z-50 bg-(--bg)/80 backdrop-blur-xl border-b border-(--border)"
>
  <div class="container mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Sophisticated Hex Logo -->
    <a
      href="/"
      class="flex items-center gap-3 group"
      aria-label="Web3Blog home"
    >
      <div
        class="relative w-8 h-8 shrink-0 transition-transform group-hover:scale-105"
      >
        <svg viewBox="0 0 32 32" class="w-8 h-8">
          <polygon
            points="16,2 28,10 28,22 16,30 4,22 4,10"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"></polygon>
          <path
            d="M12 11h8M12 16h5M12 21h8"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></path>
        </svg>
      </div>
      <span
        class="text-xl font-bold font-heading tracking-tight group-hover:text-primary transition-colors"
      >
        Web3<span class="opacity-60">Blog</span>
      </span>
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-6">

      <div class="flex items-center gap-2">
        <!-- Search Trigger Icon Button -->
        <button
          id="search-btn"
          class="p-2 rounded-xl border border-(--border) hover:border-primary/50 text-(--text-muted) hover:text-primary transition-all duration-200"
          aria-label="Search"
          title="Buscar (Ctrl+K)"
        >
          <svg
            class="w-4.5 h-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

        <!-- Dynamic Theme toggle -->
        <button
          id="theme-toggle"
          class="p-2 rounded-xl border border-(--border) hover:border-primary/50 text-(--text-muted) hover:text-primary transition-all duration-200"
          aria-label="Toggle Theme"
        >
          <svg
            id="theme-inner-icon"
            class="w-4.5 h-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <!-- Dynamic path will be here by JS -->
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const themeInnerIcon = document.getElementById("theme-inner-icon");
  const searchBtn = document.getElementById("search-btn");

  const sunIconPath =
    '<circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />';
  const moonIconPath =
    '<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />';

  const updateIcons = () => {
    const isDark = document.documentElement.classList.contains("dark");
    themeInnerIcon!.innerHTML = isDark ? moonIconPath : sunIconPath;
  };

  updateIcons();

  themeToggle?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
    const isDark = document.documentElement.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateIcons();
  });

  searchBtn?.addEventListener("click", () => {
    window.dispatchEvent(new Event("open-search"));
  });
</script>
